
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Запустить Python через uv",
            "type": "shell",
            "command": "uv",
            "args": [
                "run",
                "python",
                "catalog_analysis.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
